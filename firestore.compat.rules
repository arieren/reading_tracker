rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function active() {
      return signedIn() && !exists(/databases/$(database)/documents/account_deletions/$(request.auth.uid));
    }
    function deleting() { return signedIn() && exists(/databases/$(database)/documents/account_deletions/$(request.auth.uid)); }
    function owner(data) { return signedIn() && data.uid == request.auth.uid; }
    // Temporary bridge: accepts the actual legacy add/update fields as well
    // as versioned writes. Strict revision enforcement returns after cutover.
    function validLink(value) {
      // Legacy manual covers included a newline in the placeholder query.
      return value == null || (value is string && value.size() <= 4096
        && (value == '' || value.matches('(?s)https?://.+')));
    }
    function validReadTime(value) {
      return value == null || value is timestamp || (value is string && value.size() <= 64
        && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})?'));
    }
    function validReadingLink(data) {
      let value = data.get('linkURL', null);
      return value == null || (value is string && value.size() <= 4096
        && (value == '' || value.matches('(?s)https?://.+')))
        || (request.method == 'update' && value is string && value.size() <= 4096
          && value == resource.data.get('linkURL', null));
    }
    function validBook(data) {
      return data.keys().hasAll(['uid', 'title', 'type', 'chapter'])
        && data.keys().hasOnly(['uid', 'title', 'type', 'chapter', 'imageUrl', 'linkURL', 'lastRead', 'revision', 'updatedAt', 'lastOperationId'])
        && data.uid is string && data.uid.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && data.title.matches('(?s).*[^\\s].*')
        && data.type in ['Novel', 'Manga', 'Manhwa', 'Light Novel']
        && data.chapter is int && data.chapter >= 0 && data.chapter <= 2147483647
        && validLink(data.get('imageUrl', null)) && validReadingLink(data)
        && validReadTime(data.get('lastRead', null));
    }
    function legacy(data) {
      return !data.keys().hasAny(['revision', 'updatedAt', 'lastOperationId']);
    }
    function versioned(data) {
      return data.keys().hasAll(['revision', 'updatedAt', 'lastOperationId'])
        && data.revision is int && data.revision > 0 && data.updatedAt is timestamp
        && data.lastOperationId is string && data.lastOperationId.size() > 0 && data.lastOperationId.size() <= 128;
    }
    function oldStyleEdit() {
      return (legacy(resource.data) && legacy(request.resource.data))
        || (versioned(resource.data) && versioned(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['revision', 'updatedAt', 'lastOperationId']));
    }
    match /books/{bookId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/books/$(bookId)) || owner(resource.data));
      allow list: if signedIn() && owner(resource.data);
      allow create: if active() && owner(request.resource.data) && validBook(request.resource.data)
        && (legacy(request.resource.data) || (versioned(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.updatedAt == request.time))
        && !exists(/databases/$(database)/documents/book_deletions/$(bookId));
      allow update: if active() && owner(resource.data) && owner(request.resource.data)
        && validBook(request.resource.data)
        && (oldStyleEdit() || (versioned(request.resource.data) && request.resource.data.revision == resource.data.get('revision', 0) + 1 && request.resource.data.updatedAt == request.time))
        && !exists(/databases/$(database)/documents/book_deletions/$(bookId));
      // Old clients delete directly and cannot create an atomic marker.
      allow delete: if signedIn() && (active() || deleting())
        && (!exists(/databases/$(database)/documents/books/$(bookId)) || owner(resource.data));
    }
    match /book_deletions/{bookId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/book_deletions/$(bookId)) || owner(resource.data));
      allow list: if signedIn() && owner(resource.data);
      allow create: if active() && owner(request.resource.data)
        && request.resource.data.keys().hasOnly(['uid', 'deletedAt'])
        && request.resource.data.deletedAt == request.time
        && (!exists(/databases/$(database)/documents/books/$(bookId)) || owner(get(/databases/$(database)/documents/books/$(bookId)).data))
        && !existsAfter(/databases/$(database)/documents/books/$(bookId));
      allow update: if false;
      allow delete: if deleting() && owner(resource.data);
    }
    match /account_deletions/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.auth_time >= request.time.toMillis() / 1000 - 300
        && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'data-cleared' && request.resource.data.updatedAt == request.time;
      allow list, delete: if false;
    }
  }
}
